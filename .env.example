# --- Envio do diagnóstico por e-mail (ativo nesta versão) ---
# As 5 variáveis abaixo (SMTP_HOST/PORT/USER/PASSWORD + DIAGNOSTIC_OWNER_EMAIL)
# são obrigatórias: se qualquer uma faltar, o envio falha de forma controlada
# e o servidor registra nos logs (nunca na resposta HTTP) qual está ausente.
#
# Exemplo com Gmail (veja "Usando o Gmail como servidor SMTP" no README —
# é preciso gerar uma senha de app, a senha normal da conta não funciona):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu_email@gmail.com
#   SMTP_PASSWORD=<senha de app de 16 caracteres>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
# Opcional: remetente exibido no e-mail. Se omitido, usa SMTP_USER.
SMTP_FROM=diagnostico@suaempresa.com
# Opcional: "true" força conexão TLS implícita (porta 465). Na porta 465 isso
# já é ativado automaticamente mesmo sem definir esta variável.
SMTP_SECURE=false

# Para onde cada diagnóstico preenchido é enviado (obrigatória).
DIAGNOSTIC_OWNER_EMAIL=voce@suaempresa.com

# Opcional: número (com DDI/DDD) para o botão "Falar conosco pelo WhatsApp"
# na tela de confirmação. Se omitido, o botão não é exibido.
WHATSAPP_NUMBER=5511999998888

# --- IA (desativada nesta versão — ver README) ---
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=your_model_here
